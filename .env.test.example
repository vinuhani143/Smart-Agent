# =============================================================================
# MusicMix TEST environment — placeholders only. Never commit real secrets.
# Copy to backend/.env.test (gitignored) for automated tests that need a DB.
# NODE_ENV=test
# =============================================================================

NODE_ENV=test
PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081
APP_DEEP_LINK=musicmix://auth/callback

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/musicmix_test?schema=public

# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-character-test-secret
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

DEBUG_ERRORS=false

# Leave provider secrets empty unless you are running a live OAuth QA pass
# against a dedicated development app. Never use production credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
YOUTUBE_API_KEY=

AMAZON_MUSIC_ENABLED=false
AMAZON_MUSIC_API_BASE_URL=https://api.music.amazon.dev
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_MUSIC_SECURITY_PROFILE_ID=
AMAZON_MUSIC_REDIRECT_URI=http://localhost:4000/api/auth/amazon/callback

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
