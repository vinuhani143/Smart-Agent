# =============================================================================
# MusicMix local development environment — placeholders only.
# Copy to backend/.env. Localhost is allowed here because it is explicit.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
APP_DEEP_LINK=musicmix://auth/callback
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/musicmix?schema=public
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
DEBUG_ERRORS=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
YOUTUBE_API_KEY=
AMAZON_MUSIC_ENABLED=false
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_MUSIC_SECURITY_PROFILE_ID=
AMAZON_MUSIC_REDIRECT_URI=http://localhost:4000/api/auth/amazon/callback
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
INTERNAL_CLEANUP_KEY=
