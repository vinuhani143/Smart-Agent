# =============================================================================
# MusicMix production environment — placeholders only. Never commit real secrets.
# Copy to a secret manager or server .env. Do not ship these values in the app.
# =============================================================================

NODE_ENV=production
# Render injects PORT. Do not hardcode 4000 on Render.

# Public HTTPS origin of the API. Replace the placeholder. Do not use localhost.
API_PUBLIC_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Native Android does not use CORS. Set only if you also ship a web origin. Never *.
# Empty is OK for native-only. Example web origin: https://YOUR-WEB-ORIGIN
CORS_ALLOWED_ORIGINS=<your required origin>
# Legacy alias still read when CORS_ALLOWED_ORIGINS is empty.
CORS_ORIGINS=

APP_DEEP_LINK=musicmix://auth/callback

DATABASE_URL=<your Render PostgreSQL connection string>

# openssl rand -hex 32  →  <random secret 1>
JWT_SECRET=<random secret 1>
# openssl rand -hex 32  →  <random secret 2>  (64 hex chars)
TOKEN_ENCRYPTION_KEY=<random secret 2>

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/auth/spotify/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/auth/google/callback
YOUTUBE_API_KEY=

AMAZON_MUSIC_ENABLED=false
AMAZON_MUSIC_API_BASE_URL=https://api.music.amazon.dev
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_MUSIC_SECURITY_PROFILE_ID=
AMAZON_MUSIC_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/auth/amazon/callback

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

INTERNAL_CLEANUP_KEY=

DEBUG_ERRORS=false
