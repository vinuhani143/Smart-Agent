// MusicMix database schema.
// Provider tokens are stored encrypted at the application layer (see TokenService).
// Prisma never receives plaintext secrets from the React Native client.

generator client {
  provider = "prisma-client-js"
  // Schema lives at repo root; the API package consumes the client.
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MusicProviderName {
  SPOTIFY
  YOUTUBE
  AMAZON_MUSIC
}

enum GenerationStatus {
  PENDING
  GENERATED
  CONFIRMED
  CREATED
  FAILED
  EDITED
}

enum ConversionStatus {
  ANALYZED
  CONFIRMED
  CREATED
  PARTIAL
  FAILED
}

enum ConversionTrackStatus {
  MATCHED
  NEEDS_REVIEW
  NOT_FOUND
  ACCEPTED
  SKIPPED
  MANUAL
  DUPLICATE
}

model User {
  id                  String                       @id @default(cuid())
  email               String?                      @unique
  displayName         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  musicAccounts       MusicAccount[]
  playlists           Playlist[]
  generationRequests  PlaylistGenerationRequest[]
  playlistGenerations PlaylistGeneration[]
  conversions         PlaylistConversion[]
  oauthStates         OAuthState[]
}

/// Connected music-service account. accessToken and refreshToken MUST be
/// application-encrypted ciphertext, never raw OAuth tokens, never sent to the client.
model MusicAccount {
  id             String             @id @default(cuid())
  userId         String
  provider       MusicProviderName
  providerUserId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  displayName    String?
  imageUrl       String?
  subscriptionTier String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerUserId])
  @@index([userId])
}

model Track {
  id             String          @id @default(cuid())
  title          String
  artist         String
  album          String?
  durationMs     Int?
  releaseDate    DateTime?
  isrc           String?
  spotifyId      String?         @unique
  youtubeVideoId String?         @unique
  amazonMusicId  String?         @unique
  thumbnailUrl   String?
  language       String?
  genre          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  playlistTracks PlaylistTrack[]

  @@index([isrc])
  @@index([title, artist])
}

model Playlist {
  id               String             @id @default(cuid())
  userId           String
  name             String
  description      String?
  coverImageUrl    String?
  sourceProvider   MusicProviderName?
  sourcePlaylistId String?
  language         String?
  genre            String?
  mood             String?
  yearFrom         Int?
  yearTo           Int?
  targetDurationMs Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks           PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@unique([playlistId, position])
  @@index([trackId])
}

/// Saved generation job. Playlists are never created on a provider until the user confirms.
model PlaylistGenerationRequest {
  id               String             @id @default(cuid())
  userId           String
  prompt           String?
  language         String?
  mood             String?
  genre            String?
  yearFrom         Int?
  yearTo           Int?
  durationMinutes  Int?
  allowDuplicates  Boolean            @default(false)
  targetProvider   MusicProviderName?
  status           GenerationStatus   @default(PENDING)
  resultPlaylistId String?
  candidateTracks  Json?
  errorMessage     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// AI playlist generation job. The destination playlist is never created
/// on a provider until the user confirms the preview.
model PlaylistGeneration {
  id                   String             @id @default(cuid())
  userId               String
  requestText          String
  parsedIntent         Json
  generatedTitle       String?
  generatedDescription String?
  provider             String?
  destinationProvider  MusicProviderName?
  trackCount           Int                @default(0)
  durationMinutes      Int?
  totalDurationMs      Int                @default(0)
  status               GenerationStatus   @default(GENERATED)
  candidateTracks      Json
  searchQueries        Json?
  orderingStrategy     String?
  warning              String?
  resultPlaylistId     String?
  errorMessage         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Short-lived OAuth CSRF state + PKCE verifier. Never returned to the client.
model OAuthState {
  id           String            @id @default(cuid())
  userId       String
  provider     MusicProviderName
  state        String            @unique
  codeVerifier String?
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Cross-provider playlist conversion job. The destination playlist is never
/// created on a provider until the user confirms selected matches.
model PlaylistConversion {
  id                        String             @id @default(cuid())
  userId                    String
  sourceProvider            MusicProviderName
  sourcePlaylistId          String
  sourcePlaylistName        String?
  sourcePlaylistDescription String?
  destinationProvider       MusicProviderName
  destinationPlaylistId     String?
  localPlaylistId           String?
  status                    ConversionStatus   @default(ANALYZED)
  totalTracks               Int                @default(0)
  matchedTracks             Int                @default(0)
  reviewTracks              Int                @default(0)
  notFoundTracks            Int                @default(0)
  duplicateTracks           Int                @default(0)
  addedTracks               Int                @default(0)
  errorMessage              String?
  createdAt                 DateTime           @default(now())
  completedAt               DateTime?
  updatedAt                 DateTime           @updatedAt
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks                    ConversionTrack[]

  @@index([userId, createdAt])
}

model ConversionTrack {
  id                   String                @id @default(cuid())
  conversionId         String
  sourceTrackId        String
  destinationTrackId   String?
  confidence           Int                   @default(0)
  matchMethod          String?
  status               ConversionTrackStatus
  sourceSnapshot       Json
  destinationSnapshot  Json?
  alternativesSnapshot Json?
  addedToDestination   Boolean               @default(false)
  errorMessage         String?
  position             Int
  conversion           PlaylistConversion    @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@index([conversionId, position])
}
