# =============================================================================
# MusicMix environment — copy to backend/.env (or repo-root .env) and fill in.
# Never commit real secrets. Never put these values in the React Native app.
# =============================================================================

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/musicmix?schema=public

# HTTP server
PORT=4000
NODE_ENV=development

# Public origin of this API (used to build OAuth redirect URIs if not set below)
API_PUBLIC_URL=http://localhost:4000

# Allowed CORS origins (comma-separated). Include Expo web and the native app origin if needed.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Deep link the backend redirects to after OAuth (must match app.json "scheme")
APP_DEEP_LINK=musicmix://auth/callback

# Session JWT for the MusicMix user (NOT a music-provider token)
# Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key used to encrypt provider access/refresh tokens at rest (64 hex chars)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Extra error names in 500 responses. Never enable in production.
DEBUG_ERRORS=false

# -----------------------------------------------------------------------------
# Spotify Web API — https://developer.spotify.com/dashboard
# Redirect URI must match the dashboard setting exactly.
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback

# -----------------------------------------------------------------------------
# Google / YouTube Data API — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3". Redirect URI must match the OAuth client setting.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional: YouTube Data API key for unauthenticated search only.
# User playlist mutations still require a connected Google account.
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Amazon Music Web API — closed beta. Defaults to disabled.
# Do not invent credentials. Do not mock Amazon responses in production.
# Amazon Music Web API access is subject to Amazon approval. The application
# does not bypass or work around Amazon's access restrictions.
# Official API: https://api.music.amazon.dev
# Login With Amazon: https://developer.amazon.com/docs/music/API_web_LWA.html
# -----------------------------------------------------------------------------
AMAZON_MUSIC_ENABLED=false
AMAZON_MUSIC_API_BASE_URL=https://api.music.amazon.dev
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_MUSIC_SECURITY_PROFILE_ID=
AMAZON_MUSIC_REDIRECT_URI=http://localhost:4000/api/auth/amazon/callback
# Optional aliases if you already named LWA credentials this way:
AMAZON_MUSIC_CLIENT_ID=
AMAZON_MUSIC_CLIENT_SECRET=
# -----------------------------------------------------------------------------
# AI playlist generation — LLM credentials stay on the backend only.
# The model produces search criteria, ranking, and copy. It never receives or
# produces copyrighted audio. If these are empty, generate returns a setup error
# (no fake AI fallback).
# -----------------------------------------------------------------------------
# openai | anthropic | openai-compatible
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Required when AI_PROVIDER=openai-compatible (example: https://api.openai.com/v1)
AI_BASE_URL=

# Optional. Header x-musicmix-cleanup-key for POST /api/internal/remote-operations/:id/cleanup
INTERNAL_CLEANUP_KEY=


