# =============================================================================
# MusicMix production environment — placeholders only. Never commit real secrets.
# Copy to a secret manager or server .env. Do not ship these values in the app.
# =============================================================================

NODE_ENV=production
PORT=4000

# Public HTTPS origin of the API. Replace the placeholder. Do not use localhost.
API_PUBLIC_URL=https://YOUR_PRODUCTION_BACKEND_DOMAIN

# Comma-separated allowed web origins. Do not use * with credentials.
CORS_ORIGINS=https://YOUR_PRODUCTION_WEB_ORIGIN

APP_DEEP_LINK=musicmix://auth/callback

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/musicmix?schema=public&sslmode=require

# openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://YOUR_PRODUCTION_BACKEND_DOMAIN/api/auth/spotify/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_PRODUCTION_BACKEND_DOMAIN/api/auth/google/callback
YOUTUBE_API_KEY=

AMAZON_MUSIC_ENABLED=false
AMAZON_MUSIC_API_BASE_URL=https://api.music.amazon.dev
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_MUSIC_SECURITY_PROFILE_ID=
AMAZON_MUSIC_REDIRECT_URI=https://YOUR_PRODUCTION_BACKEND_DOMAIN/api/auth/amazon/callback

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

INTERNAL_CLEANUP_KEY=

DEBUG_ERRORS=false
