# =============================================================================
# MusicMix environment — copy to backend/.env (or repo-root .env) and fill in.
# Never commit real secrets. Never put these values in the React Native app.
# =============================================================================

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/musicmix?schema=public

# HTTP server
PORT=4000
NODE_ENV=development

# Public origin of this API (used to build OAuth redirect URIs if not set below)
API_PUBLIC_URL=http://localhost:4000

# Allowed CORS origins (comma-separated). Include Expo web and the native app origin if needed.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Deep link the backend redirects to after OAuth (must match app.json "scheme")
APP_DEEP_LINK=musicmix://auth/callback

# Session JWT for the MusicMix user (NOT a music-provider token)
# Generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key used to encrypt provider access/refresh tokens at rest (64 hex chars)
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Spotify Web API — https://developer.spotify.com/dashboard
# Redirect URI must match the dashboard setting exactly.
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/auth/spotify/callback

# -----------------------------------------------------------------------------
# Google / YouTube Data API — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3". Redirect URI must match the OAuth client setting.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional: YouTube Data API key for unauthenticated search only.
# User playlist mutations still require a connected Google account.
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Amazon Music
# Leave empty. The Amazon adapter stays disabled until official API access exists.
# Do not invent credentials or mock Amazon responses.
# -----------------------------------------------------------------------------
AMAZON_MUSIC_CLIENT_ID=
AMAZON_MUSIC_CLIENT_SECRET=
AMAZON_MUSIC_REDIRECT_URI=
